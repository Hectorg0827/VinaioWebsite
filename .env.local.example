# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — NEVER use NEXT_PUBLIC_ prefix for this one
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Anthropic AI ──────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
# Server-side only — NEVER use NEXT_PUBLIC_ prefix
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Admin Panel ───────────────────────────────────────────────────────────────
# Password to log in to /admin (product catalog management)
# Set a strong password — this is the only credential for the admin panel
ADMIN_PASSWORD=change-me-to-a-strong-password

# ─── Email Notifications (Resend) ──────────────────────────────────────────────
# Get from: https://resend.com — free tier sends 3,000 emails/month
# Contact form submissions will be emailed to CONTACT_NOTIFY_EMAIL
# Leave blank to disable email notifications (submissions still save to Supabase)
RESEND_API_KEY=re_your-resend-api-key-here
CONTACT_NOTIFY_EMAIL=your-team-email@example.com

# ─── Site URL ──────────────────────────────────────────────────────────────────
# Used for absolute redirects (e.g. after admin logout)
# On Vercel this is set automatically; only needed for local dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000
