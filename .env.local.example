# Supabase — get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — server-side only (NEVER use NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic API key — server-side only (NEVER use NEXT_PUBLIC_ prefix)
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Admin panel password — protects /admin (product catalog management)
# Set a strong password — this is the only credential for the admin panel
ADMIN_PASSWORD=change-me-to-a-strong-password
