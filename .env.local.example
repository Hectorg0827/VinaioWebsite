# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — NEVER use NEXT_PUBLIC_ prefix for this one
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Anthropic AI ──────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
# Server-side only — NEVER use NEXT_PUBLIC_ prefix
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Admin Panel ───────────────────────────────────────────────────────────────
# Password to log in to /admin (product catalog management)
# Use a strong password — at least 16 chars, mix of letters, numbers, symbols
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used to sign the admin session cookie (HMAC-SHA256 pepper)
# Generate with: openssl rand -hex 32
# Changing this immediately invalidates all existing admin sessions
ADMIN_SECRET=change-me-to-a-random-64-char-hex-string

# ─── Email Notifications (Resend) ──────────────────────────────────────────────
# Get from: https://resend.com — free tier sends 3,000 emails/month
# Contact form submissions will be emailed to CONTACT_NOTIFY_EMAIL
# Leave blank to disable email notifications (submissions still save to Supabase)
RESEND_API_KEY=re_your-resend-api-key-here
CONTACT_NOTIFY_EMAIL=your-team-email@example.com

# ─── Site URL ──────────────────────────────────────────────────────────────────
# Used for absolute redirects (e.g. after admin logout)
# On Vercel this is set automatically; only needed for local dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Bunny.net (Storage & Image CDN) ──────────────────────────────────────────
# Storage Zone Name (e.g. vinaio-assets)
BUNNY_STORAGE_ZONE=your-storage-zone-name
# Access Key (Password) for the specific Storage Zone
BUNNY_API_KEY=your-bunny-access-key
# Pull Zone Hostname (e.g. vinaio.b-cdn.net)
NEXT_PUBLIC_BUNNY_CDN_URL=https://your-pull-zone.b-cdn.net
# ─── Analytics & Monitoring ──────────────────────────────────────────────────
# Google Analytics 4 (Measurement ID)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry DSN (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
